{
  "name": "codemode-mcp-gateway-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "A code-mode gateway for MCP tools and its reusable libraries",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "bun run --cwd packages/codemode build && bun run --cwd packages/mcp build && bun run --cwd packages/gateway build",
    "build:standalone": "bun run build && bun run scripts/build-standalone.ts",
    "install:gw": "bun run scripts/install-gw.ts",
    "gw": "bun --conditions=development run packages/gateway/src/cli.ts",
    "example": "bun --conditions=development run examples/basic.ts",
    "example:mcp": "bun --conditions=development run examples/mcp.ts",
    "example:server": "bun --conditions=development run examples/agent-client.ts",
    "example:notion": "bun --conditions=development run examples/notion-client.ts",
    "baseline": "bun --conditions=development run scripts/execution-baseline.ts",
    "baseline:memory": "bun --conditions=development run scripts/memory-baseline.ts",
    "baseline:concurrency": "bun --conditions=development run scripts/concurrency-baseline.ts",
    "baseline:reliability": "bun --conditions=development run scripts/reliability-baseline.ts",
    "validate:agents": "bun --conditions=development run scripts/agent-validation.ts",
    "baseline:gateway": "bun --conditions=development run scripts/gateway-soak.ts",
    "validate:http-idle": "bun run scripts/http-idle.ts",
    "validate:models": "bun run scripts/model-validation.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun run --cwd packages/codemode test && bun run --cwd packages/mcp test && bun run --cwd packages/gateway test",
    "lint": "oxlint --deny-warnings .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "bun run build && bun run typecheck && bun run lint && bun run format:check && bun run test && bun run scripts/verify-packages.ts && bun run scripts/build-standalone.ts && bun run scripts/verify-standalone.ts",
    "verify:standalone": "bun run build:standalone && bun run scripts/verify-standalone.ts",
    "verify:packages": "bun run build && bun run scripts/verify-packages.ts",
    "verify:packages:clean": "bun run scripts/verify-clean-packages.ts"
  },
  "devDependencies": {
    "@codemode-mcp-gateway/codemode": "workspace:*",
    "@codemode-mcp-gateway/mcp": "workspace:*",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@standard-schema/spec": "1.1.0",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/bun": "1.4.2",
    "@types/proper-lockfile": "4.1.4",
    "acorn": "8.19.0",
    "ajv": "8.18.0",
    "ajv-formats": "3.0.1",
    "codemode-mcp-gateway": "workspace:*",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "quickjs-emscripten": "0.32.0",
    "typescript": "7.0.2",
    "zod": "4.3.6"
  },
  "engines": {
    "bun": "1.4.3"
  },
  "packageManager": "bun@1.4.3",
  "patchedDependencies": {
    "quickjs-emscripten-core@0.32.0": "patches/quickjs-emscripten-core@0.32.0.patch"
  }
}
