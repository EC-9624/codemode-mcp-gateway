{
  "name": "mcm",
  "version": "0.0.0",
  "private": true,
  "description": "A small production-oriented code-mode sandbox",
  "type": "module",
  "scripts": {
    "server": "bun run src/server.ts",
    "example": "bun run examples/basic.ts",
    "example:mcp": "bun run examples/mcp.ts",
    "example:server": "bun run examples/agent-client.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test ./tests",
    "lint": "oxlint --deny-warnings .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@standard-schema/spec": "1.1.0",
    "acorn": "8.19.0",
    "ajv": "8.18.0",
    "ajv-formats": "3.0.1",
    "quickjs-emscripten": "0.32.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/bun": "1.4.2",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": "1.4.2"
  },
  "packageManager": "bun@1.4.2"
}
