{
  "name": "@codemode-mcp-gateway/mcp",
  "version": "0.0.0",
  "private": true,
  "description": "Adapt MCP tools and expose an application-supplied code-mode executor",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "example": "bun --conditions=development run examples/client.ts",
    "example:server": "bun --conditions=development run examples/server.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "test": "bun --conditions=development test ./tests",
    "check": "bun run typecheck && oxlint --deny-warnings . && oxfmt --check . && bun run test",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@codemode-mcp-gateway/codemode": "workspace:*",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@standard-schema/spec": "1.1.0",
    "ajv": "8.18.0",
    "ajv-formats": "3.0.1",
    "zod": "4.3.6"
  },
  "engines": {
    "bun": "1.4.3"
  }
}
