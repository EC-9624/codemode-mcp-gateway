{
  "name": "codemode-mcp-gateway",
  "version": "0.0.0",
  "private": true,
  "description": "A Bun MCP service composing code-mode execution and upstream MCP tools",
  "license": "MIT",
  "bin": {
    "gw": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "example": "bun --conditions=development run examples/stdio-client.ts",
    "example:http": "bun --conditions=development run examples/http-client.ts",
    "example:notion": "bun --conditions=development run examples/notion-client.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "test": "bun --conditions=development test ./tests",
    "check": "bun run typecheck && oxlint --deny-warnings . && oxfmt --check . && bun run test",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@codemode-mcp-gateway/codemode": "workspace:*",
    "@codemode-mcp-gateway/mcp": "workspace:*",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/core": "2.12.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "0.223.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "proper-lockfile": "4.1.2",
    "zod": "4.3.6"
  },
  "engines": {
    "bun": "1.4.3"
  }
}
