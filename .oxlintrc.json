{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import"],
  "jsPlugins": ["@stylistic/eslint-plugin"],
  "categories": {
    "correctness": "error"
  },
  "options": {
    "typeAware": true,
    "reportUnusedDisableDirectives": "error"
  },
  "ignorePatterns": ["node_modules/**", "coverage/**"],
  "rules": {
    "@stylistic/padding-line-between-statements": [
      "error",
      { "blankLine": "always", "prev": ["if", "block-like", "for", "while", "do"], "next": "*" },
      { "blankLine": "always", "prev": "*", "next": "return" },
      {
        "blankLine": "always",
        "prev": "*",
        "next": ["multiline-const", "multiline-let", "multiline-using"]
      },
      {
        "blankLine": "always",
        "prev": ["multiline-const", "multiline-let", "multiline-using"],
        "next": "*"
      }
    ],
    "eqeqeq": "error",
    "prefer-const": "error",
    "no-else-return": "error",
    "no-nested-ternary": "error",
    "no-useless-catch": "error",
    "import/no-cycle": ["error", { "ignoreTypes": false, "ignoreExternal": true }],
    "import/no-duplicates": "error",
    "import/no-namespace": "error",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "regex": "^(@codemode-mcp-gateway/(codemode|mcp)|codemode-mcp-gateway)/|(^|/)(codemode|mcp|gateway)/(src|tests|dist)/",
            "message": "Use the owning package's public entry point, not its implementation or tests."
          }
        ]
      }
    ],
    "oxc/no-accumulating-spread": "error",
    "typescript/consistent-type-imports": ["error", { "fixStyle": "inline-type-imports" }],
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-inferrable-types": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-unsafe-type-assertion": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/await-thenable": "error",
    "typescript/no-floating-promises": ["error", { "checkThenables": true, "ignoreVoid": false }],
    "typescript/no-misused-promises": "error"
  }
}
